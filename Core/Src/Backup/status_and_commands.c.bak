#include "status_and_commands.h"

#include "main.h"
#include "FreeRTOS.h"
#include "task.h"
#include "cmsis_os.h"
#include "cmt_utils.h"
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "can.h"
#include <math.h>

// Primary CANbus error flag = 8 error counts
// Threshold for error passive is 120 error count
// Threshold for bus off state is 255 errors counts
// Passive state threshold: 120/8 = 15 errors
// Bus off state threshold: 255/8 = 31 errors
// 20 errors seems reasonable
#define CAN_1_TRANSMISSION_ERRORS_FAULT_THRESHOLD 20
#define CAN_2_TRANSMISSION_ERRORS_FAULT_THRESHOLD 20

// 0 - no pending transmission
// 1 - pending transmission
#define CAN_TRANSMISSION_NOT_PENDING 0
#define CAN_TRANSMISSION_PENDING 1

int CAN_1_transmission_error_counter = 0;
int CAN_2_transmission_error_counter = 0;
bool CAN_1_disabled = false;
bool CAN_2_disabled = false;

uint32_t number_of_free_CAN_1_Tx_mailboxes = 0;
uint32_t CAN_1_transmission_pending_status = CAN_TRANSMISSION_NOT_PENDING;

uint32_t number_of_free_CAN_2_Tx_mailboxes = 0;
uint32_t CAN_2_transmission_pending_status = CAN_TRANSMISSION_NOT_PENDING;

// To transmit CAN messages
bool CAN_transmit(uint8_t* data, int dlc, int id, int can_line, int CAN_ID_format)
{

	bool CAN_transmission_sucessful = false;

	CAN_TxHeaderTypeDef CAN_TxHeader = {
				.RTR = CAN_RTR_DATA,
				.DLC = dlc

	};

	// Standard ID
	if (CAN_ID_format == 0)
	{

		CAN_TxHeader.IDE = CAN_ID_STD;
		CAN_TxHeader.StdId = id;

	}

	// Extended ID
	else
	{

		CAN_TxHeader.IDE = CAN_ID_EXT;
		CAN_TxHeader.ExtId = id;

	}

	// Create buffer with size of the dlc
	uint8_t txData[dlc];

	// Fill the transmit buffer with the data
	for (int i = 0; i < dlc; i++)
	{

		txData[i] = data[i];

	}

	// Select CAN Line
	if(can_line == CAN_1)
	{

		if( mutex_CAN_1Handle != NULL )
		{

			// Acquire the mutex for CAN 1
			osSemaphoreAcquire(mutex_CAN_1Handle, osWaitForever);

			// Check if any mailboxes are free
			number_of_free_CAN_1_Tx_mailboxes = HAL_CAN_GetTxMailboxesFreeLevel(&hcan1);

			// Check if a transmission is pending
			CAN_1_transmission_pending_status = HAL_CAN_IsTxMessagePending(&hcan1, TxMailbox);

			// Only attempt to transmit a CAN message if at least 1 mailbox is free
			if(number_of_free_CAN_1_Tx_mailboxes > 0)
			{

				/*** Transmit CAN 1 Message ***/

				// Transmit CAN message
				if(HAL_CAN_AddTxMessage(&hcan1, &CAN_TxHeader, txData, &TxMailbox) != HAL_OK)
				{

					// Increment error fault counter for every failed CAN transmission
					CAN_1_transmission_error_counter += 1;
					CAN_transmission_sucessful = false;

				}

				else
				{

					CAN_transmission_sucessful = true;

					if(CAN_1_transmission_error_counter > 0)
					{

						// Decrement error fault counter for every sucessful CAN transmission
						CAN_1_transmission_error_counter -= 1;

					}

				}

			}

			// If no mailboxes are free and a CAN transmission is pending, abort the most recent transmission request
			// Objective of this code is to make sure that if no mailboxes are free, we can abort the most recent CAN transmission
			// This might allow stuff to get transmitted again
			else if(CAN_1_transmission_pending_status == CAN_TRANSMISSION_PENDING)
			{

				// Abort CAN transmission
				// Frees space in the mailbox
				HAL_CAN_AbortTxRequest(&hcan1, TxMailbox);

			}

			// For logging CAN error status to dash
			if(CAN_1_transmission_error_counter > CAN_1_TRANSMISSION_ERRORS_FAULT_THRESHOLD)
			{

				// Update fault status value for logging to dash
				p_vehicle_state_data->CAN_error_status = SETBIT(p_vehicle_state_data->CAN_error_status, 1);

				// Handle error by disabling and re-enabling CAN
				CAN_1_Error_Handler();

			}

			else
			{

				// Update fault status value for logging to dash
				p_vehicle_state_data->CAN_error_status = RESETBIT(p_vehicle_state_data->CAN_error_status, 1);

			}

			// Release the mutex for CAN 1
			osSemaphoreRelease(mutex_CAN_1Handle);

		}

	}

	else if(can_line == CAN_2)
	{

		if( mutex_CAN_2Handle != NULL )
		{

			// Acquire the mutex for CAN 1
			osSemaphoreAcquire(mutex_CAN_2Handle, osWaitForever);

			// Check if any mailboxes are free
			number_of_free_CAN_2_Tx_mailboxes = HAL_CAN_GetTxMailboxesFreeLevel(&hcan2);

			// Check if a transmission is pending
			CAN_2_transmission_pending_status = HAL_CAN_IsTxMessagePending(&hcan2, TxMailbox_CAN2);

			// Only attempt to transmit a CAN message if at least 1 mailbox is free
			if(number_of_free_CAN_2_Tx_mailboxes > 0)
			{

				/*** Transmit CAN 2 Message ***/

				// Transmit CAN message
				if(HAL_CAN_AddTxMessage(&hcan2, &CAN_TxHeader, txData, &TxMailbox_CAN2) != HAL_OK)
				{

					// Increment error fault counter for every failed CAN transmission
					CAN_2_transmission_error_counter += 1;
					CAN_transmission_sucessful = false;

				}

				else
				{

					CAN_transmission_sucessful = true;

					if(CAN_2_transmission_error_counter > 0)
					{

						// Decrement error fault counter for every sucessful CAN transmission
						CAN_2_transmission_error_counter -= 1;

					}

				}

			}

			// If no mailboxes are free and a CAN transmission is pending, abort the most recent transmission request
			// Objective of this code is to make sure that if no mailboxes are free, we can abort the most recent CAN transmission
			// This might allow stuff to get transmitted again
			else if(CAN_2_transmission_pending_status == CAN_TRANSMISSION_PENDING)
			{

				// Abort CAN transmission
				// Frees space in the mailbox
				HAL_CAN_AbortTxRequest(&hcan2, TxMailbox_CAN2);

			}

			// For logging CAN error status to dash
			if(CAN_2_transmission_error_counter > CAN_2_TRANSMISSION_ERRORS_FAULT_THRESHOLD)
			{

				// Update fault status value for logging to dash
				p_vehicle_state_data->CAN_error_status = SETBIT(p_vehicle_state_data->CAN_error_status, 2);

				// Handle error by disabling and re-enabling CAN
				CAN_2_Error_Handler();

			}

			else
			{

				// Update fault status value for logging to dash
				p_vehicle_state_data->CAN_error_status = RESETBIT(p_vehicle_state_data->CAN_error_status, 2);

			}

			// Release the mutex for CAN 1
			osSemaphoreRelease(mutex_CAN_2Handle);

		}
	}

	return CAN_transmission_sucessful;

}

// Error Handler to handle with CAN 1 Errors
void CAN_1_Error_Handler()
{

	if((CAN_1_transmission_error_counter > CAN_1_TRANSMISSION_ERRORS_FAULT_THRESHOLD) && (CAN_1_disabled == false))
	{

		// Disable CAN
		HAL_CAN_Stop(&hcan1);
		HAL_CAN_DeInit(&hcan1);

		CAN_1_disabled = true;

		// Reset variable
		CAN_1_transmission_error_counter = 0;

		// Delay before enabling CAN 1 again
		osDelay(2000);

	}

	else if(CAN_1_disabled == true)
	{

		// Re-enable CAN
		HAL_CAN_Init(&hcan1);
		HAL_CAN_Start(&hcan1);
		CAN_1_disabled = false;

	}

}

// Error Handler to handle with CAN 2 Errors
void CAN_2_Error_Handler()
{

	if((CAN_2_transmission_error_counter > CAN_2_TRANSMISSION_ERRORS_FAULT_THRESHOLD) && (CAN_2_disabled == false))
	{

		// Disable CAN
		HAL_CAN_Stop(&hcan2);
		HAL_CAN_DeInit(&hcan2);

		CAN_2_disabled = true;

		// Reset variable
		CAN_2_transmission_error_counter = 0;

		// Delay before enabling CAN 2 again
		osDelay(2000);

	}

	else if(CAN_2_disabled == true)
	{

		// Re-enable CAN
		HAL_CAN_Init(&hcan2);
		HAL_CAN_Start(&hcan2);
		CAN_2_disabled = false;

	}

}

// To request inverter parameters
void transmit_inverter_register_request(uint8_t REG_ID, int data_receive_cycle_time_milliseconds, int data_request_is_cyclic)
{

	// Initialises array to store data
	uint8_t data[THREE_BYTES];
	int dlc = THREE_BYTES;
	int id = TRANSMIT_DATA_TO_INVERTER_CAN_ID;

	int CAN_inverter_register_request_transmission_fail_counter = 0;

	uint32_t xCAN_transmission_status = 0;

	data[0] = 0x3D; // Tells Inverter we are requesting register to read data from
	data[1] = REG_ID; // Inverter Register ID

	// Overflow detection
	// Time interval can be set between 1 to 254ms
	if(data_request_is_cyclic == 1)
	{

		if(data_receive_cycle_time_milliseconds < 1)
		{

			data_receive_cycle_time_milliseconds = 1;

		}

		else if(data_receive_cycle_time_milliseconds > 254)
		{

			data_receive_cycle_time_milliseconds = 254;

		}

		// How often we are requesting data from Inverter
		data[2] = data_receive_cycle_time_milliseconds;

	}

	else
	{
		// Requesting once
		data[2] = 0;

	}

	// Transmit CAN message to Inverter

	CAN_TxHeaderTypeDef CAN_TxHeader = {
				.RTR = CAN_RTR_DATA,
				.DLC = dlc,
				.IDE = CAN_ID_STD,
				.StdId = id

	};

	if( mutex_CAN_1Handle != NULL )
	{

		// Acquire the mutex for CAN 1
		osSemaphoreAcquire(mutex_CAN_1Handle, osWaitForever);

		// If CAN transmission fails, try again until succesful
		// Each Register request CAN transmission is critical and must be successful
		// Keep trying if initial attempt fails
		do
		{

			xCAN_transmission_status = HAL_CAN_AddTxMessage(&hcan1, &CAN_TxHeader, data, &TxMailbox);

			if(xCAN_transmission_status != HAL_OK)
			{

				CAN_inverter_register_request_transmission_fail_counter += 1;

			}

			 // Limit to 50 attempts to prevent VCU from getting stuck in the while loop
		} while((xCAN_transmission_status != HAL_OK) && (CAN_inverter_register_request_transmission_fail_counter < 50));

		// Release the mutex for CAN 1
		osSemaphoreRelease(mutex_CAN_1Handle);

	}

}

// Check faults status from HFLBs
uint8_t HFLB_fault_status_check(void)
{
	uint8_t warning_lights_fault_LEDs_control_command = 0b00000000;
	if(!CHECK_BMS_FAULT_STATUS())
	{

		// Wait 100ms
		osDelay(100);

		if(!CHECK_BMS_FAULT_STATUS())
		{

			// Set Bit HIGH
			warning_lights_fault_LEDs_control_command = SETBIT(warning_lights_fault_LEDs_control_command, 3);

			p_vehicle_state_data->hard_faults_status = SETBIT(p_vehicle_state_data->hard_faults_status, 3);

		}

	}

	if(!CHECK_IMD_FAULT_STATUS())
	{

		// Wait 100ms
		osDelay(100);

		if(!CHECK_IMD_FAULT_STATUS())
		{

			// Set Bit HIGH
			warning_lights_fault_LEDs_control_command = SETBIT(warning_lights_fault_LEDs_control_command, 1);

			p_vehicle_state_data->hard_faults_status = SETBIT(p_vehicle_state_data->hard_faults_status, 1);

		}

	}

	if(!CHECK_BSPD_FAULT_STATUS())
	{

		// Wait 100ms
		osDelay(100);

		if(!CHECK_BSPD_FAULT_STATUS())
		{

			// Set Bit HIGH
			warning_lights_fault_LEDs_control_command = SETBIT(warning_lights_fault_LEDs_control_command, 2);

			p_vehicle_state_data->hard_faults_status = SETBIT(p_vehicle_state_data->hard_faults_status, 2);

		}

	}

	if(!CHECK_POC_FAULT_STATUS() || !CHECK_DOC_FAULT_STATUS())
	{

		// Wait 100ms
		osDelay(100);

		if(!CHECK_POC_FAULT_STATUS() || !CHECK_DOC_FAULT_STATUS())
		{

			// Set Bit HIGH
			warning_lights_fault_LEDs_control_command = SETBIT(warning_lights_fault_LEDs_control_command, 0);

			p_vehicle_state_data->hard_faults_status = SETBIT(p_vehicle_state_data->hard_faults_status, 0);

		}

	}

	return warning_lights_fault_LEDs_control_command;

}

// Format torque command for the Inverter
bool transmit_inverter_torque_command(int torque_command_percentage)
{

	bool torque_command_transmission_sucessful = false;

	// Initialise buffer for CAN data
	uint8_t txData[THREE_BYTES] = {0};

	// Store final torque command between 0 and 32767
	int torque_command = 0;

	// Calculate final torque command
	torque_command = (int) (MAX_TORQUE_COMMAND * ( ((float) torque_command_percentage)/100));

	// Zero torque command
	if(torque_command_percentage == 0)
	{

		torque_command = 0;

	}

	// Check for out of range values
	if(torque_command > MAX_TORQUE_COMMAND)
	{

		torque_command = MAX_TORQUE_COMMAND;

	}

	else if(torque_command < 0)
	{

		torque_command = 0;

	}

	// Set REG ID for Torque Command
	txData[0] = INVERTER_TORQUE_COMMAND_REG_CAN_ID;

	// Format in little endian
	txData[1] = ((torque_command & 0x000000FF) >> 0);
	txData[2] = ((torque_command & 0x0000FF00) >> 8);

	// Transmit torque command to Inverter
	if(CAN_transmit(txData, THREE_BYTES, TRANSMIT_DATA_TO_INVERTER_CAN_ID, CAN_1, CAN_STD_ID_FORMAT) == true)
	{

		torque_command_transmission_sucessful = true;

		// Update fault status value for logging to dash
		p_vehicle_state_data->CAN_error_status = RESETBIT(p_vehicle_state_data->CAN_error_status, 0);

	}

	else
	{

		torque_command_transmission_sucessful = false;

		// Update fault status value for logging to dash
		p_vehicle_state_data->CAN_error_status = SETBIT(p_vehicle_state_data->CAN_error_status, 0);

	}

	return torque_command_transmission_sucessful;

}

void transmit_inverter_speed_limit(bool disable_speed_limit)
{

	// Initialize buffer for CAN data
	uint8_t txData[THREE_BYTES] = {0};

	int speed_limit_command = 0;
	float wheel_RPM = 0;
	float motor_RPM = 0;

	// 16 inch tyre diameter
	float tyre_diameter_metres = 0.4064;
	float gearing_ratio = 2.90;

	float max_motor_RPM = 5500;

	// Set REG ID for Torque Command
	txData[0] = INVERTER_SPEED_LIMIT_REG_CAN_ID;

	// Calculate Wheel RPM
	wheel_RPM = ( (float)(p_E_Interface_data->speed_limit_kmph/3.6) / (PI * tyre_diameter_metres));

	// Calculate Motor RPM
	motor_RPM = wheel_RPM * gearing_ratio;

	speed_limit_command = (MAX_SPEED_LIMIT_COMMAND * (motor_RPM/max_motor_RPM));

	// Reset speed limit
	if(disable_speed_limit == true)
	{

		speed_limit_command = MAX_SPEED_LIMIT_COMMAND;

	}

	// Format in little ENDIAN
	txData[1] = ((speed_limit_command & 0x000000FF) >> 0);
	txData[2] = ((speed_limit_command & 0x0000FF00) >> 8);

	// Transmit speed limit to Inverter
	CAN_transmit(txData, THREE_BYTES, TRANSMIT_DATA_TO_INVERTER_CAN_ID, CAN_1, CAN_STD_ID_FORMAT);

}

// Set PWM output
void set_PWM_output(TIM_HandleTypeDef* timer_handle, uint8_t timer_channel, int duty_cycle_percentage)
{

	int max_duty_cycle_percentage = 100;
	int min_duty_cycle_percentage = 0;

	uint8_t duty_cycle = 0;
	uint16_t timer_counter_period = 0;

	// Check duty cycle percentage for overflow
	if(duty_cycle_percentage > max_duty_cycle_percentage)
	{

		duty_cycle_percentage = max_duty_cycle_percentage;

	}

	else if(duty_cycle_percentage < min_duty_cycle_percentage)
	{

		duty_cycle_percentage = min_duty_cycle_percentage;

	}

	// Get timer period
	// Timer period defines max duty cycle
	timer_counter_period = __HAL_TIM_GET_AUTORELOAD(timer_handle);

	// Calculate duty cycle
	// Round up to nearest integer if timer period is odd
	duty_cycle = ( (int)timer_counter_period * ((float)duty_cycle_percentage/100) );

	// Check duty cycle for overflow
	if(duty_cycle > timer_counter_period)
	{

		duty_cycle = timer_counter_period;

	}

	else if(duty_cycle < 0)
	{

		duty_cycle = 0;

	}

	// Start Timer
	HAL_TIM_PWM_Start(timer_handle, timer_channel);

	// Set duty cycle
	__HAL_TIM_SET_COMPARE(timer_handle, timer_channel, duty_cycle);

}

// Calculate ON and OFF time for a PWM output
// Software timer method of generating a PWM output
void calculate_PWM_time_periods(int cooling_pump_frequency_Hz, int cooling_pump_duty_cycle_percentage)
{

	int cooling_pump_time_period_milliseconds = 0;

	// Pump designed for 50 - 1000 Hz
	// Fix out of bound values accordingly to stay within limits
	if(cooling_pump_frequency_Hz < 50)
	{

		cooling_pump_frequency_Hz = 50;

	}

	else if(cooling_pump_frequency_Hz > 1000)
	{

		cooling_pump_frequency_Hz = 1000;

	}

	cooling_pump_time_period_milliseconds = (1000 * ( (1 / ((float) cooling_pump_frequency_Hz)) ));

	if(cooling_pump_duty_cycle_percentage < 0)
	{

		cooling_pump_duty_cycle_percentage = 0;

	}

	else if(cooling_pump_duty_cycle_percentage > 100)
	{

		cooling_pump_duty_cycle_percentage = 100;

	}

	p_vehicle_state_data->cooling_pump_ON_time_period_milliseconds = (cooling_pump_time_period_milliseconds * ( ((float) cooling_pump_duty_cycle_percentage) /100));

	p_vehicle_state_data->cooling_pump_OFF_time_period_milliseconds = (cooling_pump_time_period_milliseconds - p_vehicle_state_data->cooling_pump_ON_time_period_milliseconds);

}

// CAN Transfer for Inverter data
void transfer_inverter_data_to_CAN_2(uint8_t* rxData, int dlc, int REG_ID)
{

	int8_t rxDataSigned[8] = {0};

	int current_actual = 0;

	// Inverter only sends 4 byte or 6 byte messages
	// Byte 0 - REG ID
	// Last byte - ignored
	// Rest of bytes - data

	int inverter_data_dlc = 0;

	// Check dlc is correct
	if(dlc > 0)
	{

		// Decrement dlc by 2
		// Becaue first byte is REG ID and last byte is to be ignored
		inverter_data_dlc = dlc - 2;

	}

	else
	{

		inverter_data_dlc = 0;

	}

	// New array to store data for inverter
	uint8_t inverter_CAN_data[inverter_data_dlc];

	// Zero the array
	for(int i = 0; i < inverter_data_dlc; i++)
	{

		inverter_CAN_data[i] = 0;

	}

	// Determine which Inverter REG ID is being received
	switch(REG_ID)
	{

		case INVERTER_VOUT_REG_ID: // 6 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_VOUT_DASH_CAN_ID);

			break;

		case INVERTER_CURRENT_ACTUAL_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_CURRENT_ACTUAL_DASH_CAN_ID);

			break;

		case INVERTER_CURRENT_COMMAND_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_CURRENT_COMMAND_DASH_CAN_ID);

			break;

		case INVERTER_SPEED_ACTUAL_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_SPEED_ACTUAL_DASH_CAN_ID);

			break;

		case INVERTER_MOTOR_TEMPERATURE_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_MOTOR_TEMPERATURE_DASH_CAN_ID);

			break;

		case INVERTER_POWER_STAGE_TEMPERATURE_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_POWER_STAGE_TEMPERATURE_DASH_CAN_ID);

			break;

		case INVERTER_MOUT_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_MOUT_DASH_CAN_ID);

			break;

		case INVERTER_DC_BUS_VOLTAGE_REG_ID: // 4 byte message

			// Format data for CAN transmission to dash
			format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_DC_BUS_VOLTAGE_DASH_CAN_ID);

			break;

		case INVERTER_FAULT_STATUS_REG_ID:
		 format_and_transmit_inverter_data_to_AiM_dash(inverter_CAN_data, rxData, inverter_data_dlc, INVERTER_FAULT_STATUS_CAN_ID);
		break;

	}

}

// Format data for CAN transmission to AiM dash
void format_and_transmit_inverter_data_to_AiM_dash(uint8_t* inverter_CAN_data, uint8_t* rxData, int inverter_data_dlc, uint8_t AiM_dash_CAN_ID)
{

	for(int i = 0; i < inverter_data_dlc; i++)
	{

		// Format data in big endian to send to dash
		inverter_CAN_data[i] = rxData[inverter_data_dlc - i];

	}

	// Transmit to AiM dash on CAN 2
	CAN_transmit(inverter_CAN_data, inverter_data_dlc, AiM_dash_CAN_ID, CAN_2, CAN_STD_ID_FORMAT);

}

// Read E_Interface data and determine what messages mean
void process_E_Interface_data(uint8_t* rxData)
{

	int message_code = rxData[0];

	// Sort based on category

	// 0-99: Controlling VCU settings
	if( (message_code >= 0) && (message_code <= 99))
	{

		switch(message_code)
		{

			case 0:

				// Turn Cooling ON
				p_E_Interface_data->cooling_channel_enabled = true;

				break;

			case 1:

				// Turn Cooling OFF
				p_E_Interface_data->cooling_channel_enabled = false;

				break;

		}

	}

	// 100-199: Controlling Power Stuff
	if( (message_code >= 100) && (message_code <= 199))
	{

		switch(message_code)
		{

			case 99:

				p_E_Interface_data->speed_limiting_enabled = true;

				// Read speed limit
				p_E_Interface_data->speed_limit_kmph = rxData[1];

				break;

			case 100:

				// Reset speed limit
				p_E_Interface_data->speed_limiting_enabled = false;

				break;

		}

	}

}





